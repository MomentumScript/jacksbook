{
  "expo": {
    "name": "Jacksbook",
    "slug": "jacksbook",
    "scheme": "jacksbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b5cff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentumscript.jacksbook"
    },
    "android": {
      "package": "com.momentumscript.jacksbook",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b5cff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Jacksbook needs your photos so you can post pictures and set a profile picture."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
